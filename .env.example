# Имя контейнера ollama из `docker ps`
OLLAMA_CONTAINER=ollama

# API ollama для блока «Сейчас в памяти»; пусто — выключить
OLLAMA_URL=http://host.docker.internal:11434

# Часовой пояс дашборда и часовой пояс внутри контейнера ollama
TZ=Europe/Moscow
OLLAMA_SERVER_TZ=UTC

# Порт дашборда на хосте
WATCHDOG_PUBLISH=8080

# Сколько дней хранить историю; 0 — бессрочно
WATCHDOG_RETENTION_DAYS=90

# Basic Auth: задайте, если порт виден не только вам
WATCHDOG_USERNAME=
WATCHDOG_PASSWORD=
